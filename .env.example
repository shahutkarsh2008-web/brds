PORT=3000
# Local only. Production requires DATABASE_URL.
SQLITE_PATH=./data/brds.sqlite
# DATABASE_URL=postgresql://user:password@host:5432/brds

# Use the exact HTTPS origin on Render (RENDER_EXTERNAL_URL is detected automatically).
# APP_ORIGIN=https://your-service.onrender.com
# Real 2Factor credentials. Leave blank until configured; login fails closed without them.
TWOFACTOR_API_KEY=
# Optional approved OTP template name.
TWOFACTOR_TEMPLATE=
# Optional first-admin bootstrap. Remove these after the account is created.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
