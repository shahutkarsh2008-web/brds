{
  "name": "brds-cbt",
  "version": "0.3.0",
  "description": "BRDS Raipur CBT exam system",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.js",
    "user:seed": "node --env-file-if-exists=.env scripts/seed-accounts.js",
    "deployment:check": "node scripts/check-deployment.js",
    "demo": "node scripts/dev-demo.js",
    "exam:import": "node --env-file-if-exists=.env scripts/import-exam.js"
  },
  "type": "module",
  "dependencies": {
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
